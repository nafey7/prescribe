{
  "name": "prescribe-e2e",
  "version": "0.0.0",
  "private": true,
  "description": "Playwright end-to-end tests for prescribe-v2. See ../docs/TESTING.md for details.",
  "scripts": {
    "test": "node --env-file=.env ./node_modules/.bin/playwright test",
    "test:headed": "node --env-file=.env ./node_modules/.bin/playwright test --headed",
    "test:debug": "node --env-file=.env ./node_modules/.bin/playwright test --debug",
    "test:report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.10.0",
    "typescript": "^5.6.0"
  }
}
