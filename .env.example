# ===========================================
# Medical AI Chat — Environment Variables
# ===========================================
# Copy this to .env and fill in your API key.

# --- LLM Provider ---
# Options: "openai" or "gemini"
LLM_PROVIDER=openai

# OpenAI API key (required if LLM_PROVIDER=openai)
OPENAI_API_KEY=your-openai-api-key-here
# Main chat model (default gpt-4o-mini). Alternatives: gpt-4o, o3-mini
# CHAT_MODEL_OPENAI=gpt-4o-mini

# Google Gemini API key (required if LLM_PROVIDER=gemini)
GOOGLE_API_KEY=
# Main chat model (default gemini-2.5-flash). Alternatives: gemini-2.0-flash, gemini-2.5-pro
# CHAT_MODEL_GOOGLE=gemini-2.5-flash

# --- MongoDB (usually no change needed for Docker) ---
MONGODB_URI=mongodb://mongodb:27017
DATABASE_NAME=medical_chat

# IANA timezone for "today" in chat prompts (default UTC). Example: America/Los_Angeles
# APP_TIMEZONE=UTC

# --- Authentication (Phase D) ---
# Default: auth required. Set JWT_SECRET to a long random value (not "change-me").
# For legacy header-only local dev, set AUTH_REQUIRED=false (and keep ENVIRONMENT=local or test).
# JWT_SECRET=
# AUTH_REQUIRED=true
# ENVIRONMENT=local
# Comma-separated origins for browser requests (Docker frontend defaults to http://localhost:5173)
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# One-shot dev utility: set bcrypt hashes on all seeded users (see docs/LOCAL_DEVELOPMENT.md)
# DEV_DEFAULT_PASSWORD=
